# Signal Stack AI - Environment Configuration Template
# Copy this file to .env and adjust values for local development

# ==============================================================================
# Backend Configuration
# ==============================================================================
PROJECT_NAME="Signal Stack AI"
ENVIRONMENT="development"
DEBUG=True

# Host & Port
HOST="127.0.0.1"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Database (SQLite default for rapid local development)
DATABASE_URL="sqlite:///./signal_stack.db"

# AI Provider Settings
# Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Ollama (Local LLM fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Default Provider ("gemini" or "ollama")
DEFAULT_AI_PROVIDER="gemini"

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
